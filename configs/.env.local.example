# ==============================================================================
# Spider Awesome 本地个人配置 (.env.local.example) —— 脱敏模板
# ==============================================================================
#
# 【使用说明】
#   复制本文件为 .env.local，填入真实配置值
#   cp .env.local.example .env.local
#
# 【注意】
#   .env.local 包含敏感信息，已加入 .gitignore，禁止提交 Git
# ==============================================================================

# 数据库连接串（按需选一个）
# DATABASE_URL=sqlite:///var/database/spider_awesome.sqlite3
# DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/spider_awesome
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/spider_awesome
