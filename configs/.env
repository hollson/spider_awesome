# ==============================================================================
# Spider Awesome 公共基础配置 (.env) —— 全量脱敏模板
# ==============================================================================
#
# 【文件定位】
#   本文件是全量配置的脱敏模板，包含项目所有配置项，作为配置字典与兜底默认值。
#   - 非敏感项：保留真实默认值，可直接使用
#   - 敏感项（数据库密码、API 密钥）：脱敏占位，真实值由环境专属文件或系统环境变量注入
#
# 【加载顺序】（全部 override=True，后加载覆盖先加载）
#   .env（本文件）→ .env.{ENV_MODE} → .env.local
#
# 【配置优先级】（从高到低，不可逆）
#   1. 系统环境变量（容器/K8s 注入，最高优先级）
#   2. .env.local（个人本地配置，禁止提交 Git）
#   3. .env.dev / .env.test / .env.prod（环境专属配置）
#   4. .env（本文件，公共基础兜底）
#   5. 代码中定义的默认值
#
# 【环境切换】
#   通过 ENV_MODE 环境变量切换加载的环境文件：
#     export ENV_MODE=dev   （默认）
#     export ENV_MODE=test
#     export ENV_MODE=prod
# ==============================================================================


# ===========================================================================
# 🔧 应用基础配置
# ===========================================================================

APP_NAME=spider_awesome
APP_VERSION=1.0.0

# 运行环境: dev | test | prod
ENV_MODE=dev

# 调试模式
DEBUG=false

# 日志级别: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO


# ===========================================================================
# 🌐 服务配置
# ===========================================================================

SERVER_HOST=0.0.0.0
SERVER_PORT=8000


# ===========================================================================
# 🗄️ 数据库（统一连接串，切换只需改这一行）
# ===========================================================================
# sqlite:///相对路径 | postgresql://user:pass@host:port/db | mysql+pymysql://user:pass@host:port/db

DATABASE_URL=sqlite:///var/database/spider_awesome.sqlite3

# DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/spider_awesome

# DATABASE_URL=mysql+pymysql://root:123456@192.168.101.251:3306/spider_awesome


# ===========================================================================
# 🔐 安全配置
# ===========================================================================

# ===========================================================================
# 📁 目录配置
# ===========================================================================

# 原始数据缓存目录（采集器保存的 API 响应、HTML 等原始数据）
RAW_DATA_DIR=var/raw

# 输出目录（测试覆盖率报告、分析报告等）
OUTPUT_DIR=var/output

# 缓存目录（pytest 缓存、ruff 缓存等工具产生的临时文件）
CACHE_DIR=var/cache

# HTTP 代理（可选）
HTTP_PROXY=
HTTPS_PROXY=


# ===========================================================================
# ⏰ 调度配置
# ===========================================================================

# 是否启用定时调度
SCHEDULER_ENABLED=true

# 并行模式: true=多采集器并行, false=串行
SCHEDULER_PARALLEL=false

# 最大并发任务数
MAX_WORKERS=5

# 单任务超时时间（秒）
TASK_TIMEOUT=300

# 失败重试次数
RETRY_COUNT=3

# 重试间隔（秒）
RETRY_DELAY=60


# ===========================================================================
# 📡 采集器配置（ENV 覆盖，优先级最高）
# ===========================================================================
# 格式：COLLECTOR_{NAME}_{FIELD}
# 示例：
#   COLLECTOR_ALERION_ENABLED=true
#   COLLECTOR_ASL_CRON=0 */3 * * *
#   COLLECTOR_NOBLE_TIMEOUT=600
#
# 详细配置请编辑 configs/collectors.yml 或 collectors.local.yml


# ===========================================================================
# 📝 日志配置
# ===========================================================================

# 日志级别: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# 日志文件路径（为空则仅输出到终端）
LOG_FILE=var/logs/spider_awesome.log

# 日志保留天数
LOG_RETENTION=7
