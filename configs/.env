# ==============================================================================
# Spider Awesome 公共基础配置 (.env) —— 全量脱敏模板
# ==============================================================================
#
# 【文件定位】
#   本文件是全量配置的脱敏模板，包含项目所有配置项，作为配置字典与兜底默认值。
#   - 非敏感项：保留真实默认值，可直接使用
#   - 敏感项（数据库密码、API 密钥）：脱敏占位，真实值由环境专属文件或系统环境变量注入
#
# 【加载顺序】（全部 override=True，后加载覆盖先加载）
#   .env（本文件）→ .env.{ENV_MODE} → .env.local
#
# 【配置优先级】（从高到低，不可逆）
#   1. 系统环境变量（容器/K8s 注入，最高优先级）
#   2. .env.local（个人本地配置，禁止提交 Git）
#   3. .env.dev / .env.test / .env.prod（环境专属配置）
#   4. .env（本文件，公共基础兜底）
#   5. 代码中定义的默认值
#
# 【环境切换】
#   通过 ENV_MODE 环境变量切换加载的环境文件：
#     export ENV_MODE=dev   （默认）
#     export ENV_MODE=test
#     export ENV_MODE=prod
# ==============================================================================


# ===========================================================================
# 🔧 应用基础配置
# ===========================================================================

APP_NAME=spider_awesome
APP_VERSION=1.0.0

# 运行环境: dev | test | prod
ENV_MODE=dev

# 调试模式
DEBUG=false

# 日志级别: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO


# ===========================================================================
# 🌐 服务配置
# ===========================================================================

SERVER_HOST=0.0.0.0
SERVER_PORT=8000


# ===========================================================================
# 🗄️ 数据库（统一连接串，切换只需改这一行）
# ===========================================================================
# sqlite:///相对路径 | postgresql://user:pass@host:port/db | mysql+pymysql://user:pass@host:port/db

DATABASE_URL=sqlite:///var/database/spider_awesome.sqlite3

# DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/spider_awesome

# DATABASE_URL=mysql+pymysql://root:123456@192.168.101.251:3306/spider_awesome


# ===========================================================================
# 🔐 安全配置
# ===========================================================================

# ===========================================================================
# 📁 目录配置
# ===========================================================================

# 原始数据缓存目录（采集器保存的 API 响应、HTML 等原始数据）
RAW_DATA_DIR=var/raw

# 输出目录（测试覆盖率报告、分析报告等）
OUTPUT_DIR=var/output

# 缓存目录（pytest 缓存、ruff 缓存等工具产生的临时文件）
CACHE_DIR=var/cache

# ===========================================================================
# 🌐 代理配置
# ===========================================================================
# 代理模式（按优先级自动判断）：
#   ┌─────────────────────────────────────────────────────────────────┐
#   │  1. API 代理（最高优先级）                                      │
#   │     配置: PROXY_POOL_API=http://api.proxy.com/get?num=10      │
#   │     说明: 从 API 动态获取代理列表，定时刷新                     │
#   │     适用: 需要大量轮换 IP 的场景                                │
#   ├─────────────────────────────────────────────────────────────────┤
#   │  2. 自定义代理池                                               │
#   │     配置: PROXY_POOL_LIST=ip1:port1 或 ip1:port1|ip2:port2    │
#   │     说明: 一个=静态代理，多个=轮换代理池                        │
#   │     适用: 有固定代理源的场景                                    │
#   ├─────────────────────────────────────────────────────────────────┤
#   │  3. 直连（默认）                                               │
#   │     配置: PROXY_POOL_LIST=  (留空)                             │
#   │     说明: 不使用代理，直接连接                                  │
#   │     适用: 无反爬限制的场景                                      │
#   └─────────────────────────────────────────────────────────────────┘
#
#  ---------------------------- API 代理配置 ---------------------------- 
#   支持的响应格式：
#     - 纯文本：每行一个 IP:PORT
#     - JSON 数组：["ip:port", ...]
#     - JSON 对象：{"data": ["ip:port", ...]} 或 {"ip": "...", "port": ...}
#
#   常用代理服务商：
#     - 快代理:   https://www.kuaidaili.com/api/  (需注册获取 API Key)
#     - 芝麻代理: https://zhima proxy.com/api.html (需注册获取 API Key)
#     - 站大爷:   https://www.zdaye.com/api.html   (需注册获取 API Key)
#     - 讯代理:   https://www.xdaili.cn/api.html   (需注册获取 API Key)
PROXY_POOL_API=

# ---------------------------- 自定义代理池 ----------------------------
#   格式：http://host:port 或 user:pass@host:port 或 socks5://host:port
#   多个代理用 | 分隔（一个=静态，多个=轮换）
#
#   示例：
#     静态代理: http://proxy1:8080
#     轮换代理: http://proxy1:8080|http://proxy2:8080|socks5://proxy3:1080
#     带认证:   http://user:pass@proxy1:8080
PROXY_POOL_LIST=

# 轮换策略（仅多个代理时生效）：
#   random      - 随机选择（默认）
#   round_robin - 轮询
#   least_used  - 最少使用
PROXY_POOL_STRATEGY=random


# ===========================================================================
# 🎭 User-Agent 轮换配置
# ===========================================================================
# 默认开启，每次请求随机选择 UA（内置 80+ 个桌面端+移动端 UA）
# 无需配置，如需关闭请设置 UA_ROTATION_ENABLED=false
# UA_ROTATION_ENABLED=true


# ===========================================================================
# ⏱️ 请求间隔配置（防反爬）
# ===========================================================================
# 设置每次 HTTP 请求之间的随机延迟，避免频繁访问触发反爬
#
# ⚠️ 重要说明：
# - 这是【每次 HTTP 请求】的间隔，不是采集器之间的间隔
# - 分页采集场景会严重拖慢速度：
#   例：采集 100 页，每页延迟 2 秒 → 总耗时增加 200 秒
# - 建议：只在遇到反爬时才开启，且尽量设小（500-1000ms）
#
# 设置 MIN=MAX=0 表示禁用（默认禁用，推荐保持禁用）
#
REQUEST_DELAY_MIN=0
REQUEST_DELAY_MAX=0


# ===========================================================================
# 🌐 浏览器渲染配置（Playwright）
# ===========================================================================

# 是否无头模式（默认 true）
BROWSER_HEADLESS=true
# 页面加载超时（毫秒）
BROWSER_TIMEOUT=30000


# ===========================================================================
# ⏰ 调度配置
# ===========================================================================

# 是否启用定时调度
SCHEDULER_ENABLED=true

# 并行模式: true=多采集器并行, false=串行
SCHEDULER_PARALLEL=false

# 最大并发任务数
MAX_WORKERS=5

# 单任务超时时间（秒）
TASK_TIMEOUT=300

# 失败重试次数
RETRY_COUNT=3

# 重试间隔（秒）
RETRY_DELAY=60


# ===========================================================================
# 📡 采集器配置（ENV 覆盖，优先级最高）
# ===========================================================================
# 格式：COLLECTOR_{NAME}_{FIELD}
# 示例：
#   COLLECTOR_ALERION_ENABLED=true
#   COLLECTOR_ASL_CRON=0 */3 * * *
#   COLLECTOR_NOBLE_TIMEOUT=600
#
# 详细配置请编辑 src/collector/source_define.py


# ===========================================================================
# 📝 日志配置
# ===========================================================================

# 日志级别: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# 日志文件路径（为空则仅输出到终端）
LOG_FILE=var/logs/spider_awesome.log

# 日志保留天数
LOG_RETENTION=7
