# ==============================================================================
# Spider Awesome 公共基础配置 (.env) —— 全量脱敏模板
# ==============================================================================
#
# 【文件定位】
#   本文件是全量配置的脱敏模板，包含项目所有配置项，作为配置字典与兜底默认值。
#   - 非敏感项：保留真实默认值，可直接使用
#   - 敏感项（数据库密码、API 密钥）：脱敏占位，真实值由环境专属文件或系统环境变量注入
#
# 【加载顺序】（全部 override=True，后加载覆盖先加载）
#   .env（本文件）→ .env.{ENV_MODE} → .env.local
#
# 【配置优先级】（从高到低，不可逆）
#   1. 系统环境变量（容器/K8s 注入，最高优先级）
#   2. .env.local（个人本地配置，禁止提交 Git）
#   3. .env.dev / .env.test / .env.prod（环境专属配置）
#   4. .env（本文件，公共基础兜底）
#   5. 代码中定义的默认值
#
# 【环境切换】
#   通过 ENV_MODE 环境变量切换加载的环境文件：
#     export ENV_MODE=dev   （默认）
#     export ENV_MODE=test
#     export ENV_MODE=prod
# ==============================================================================


# ===========================================================================
# 🔧 应用基础配置
# ===========================================================================

APP_NAME=spider_awesome
APP_VERSION=1.0.0

# 运行环境: dev | test | prod
ENV_MODE=dev

# 调试模式
DEBUG=false

# 日志级别: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO


# ===========================================================================
# 🌐 服务配置
# ===========================================================================

SERVER_HOST=0.0.0.0
SERVER_PORT=8000


# ===========================================================================
# 🗄️ 数据库
# ===========================================================================

# 数据库类型: sqlite | postgresql | mysql
DB_TYPE=sqlite

# --- SQLite 配置 ---
SQLITE_PATH=var/database/spider_awesome.sqlite3

# --- PostgreSQL 配置 ---
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=__REPLACE_ME__
PG_DATABASE=spider_awesome

# --- MySQL 配置 ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=__REPLACE_ME__
MYSQL_DATABASE=spider_awesome


# ===========================================================================
# 🔐 安全配置
# ===========================================================================

# 原始数据缓存目录
RAW_DATA_DIR=var/raw

# HTTP 代理（可选）
HTTP_PROXY=
HTTPS_PROXY=


# ===========================================================================
# ⏰ 调度配置
# ===========================================================================

# 是否启用定时调度
SCHEDULER_ENABLED=true

# 并行模式: true=多采集器并行, false=串行
SCHEDULER_PARALLEL=false

# 最大并发任务数
MAX_WORKERS=5

# 单任务超时时间（秒）
TASK_TIMEOUT=300

# 失败重试次数
RETRY_COUNT=3

# 重试间隔（秒）
RETRY_DELAY=60

# 全局默认调度时间（cron）
COLLECTOR_CRON_HOUR=0
COLLECTOR_CRON_MINUTE=0


# ===========================================================================
# 📝 日志配置
# ===========================================================================

LOG_DIR=var/logs
