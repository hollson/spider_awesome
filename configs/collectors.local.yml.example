# ==============================================================================
# 采集器本地配置 (collectors.local.yml)
# ==============================================================================
#
# 【使用说明】
#   本文件用于本地开发时覆盖 collectors.yml 的配置
#   已加入 .gitignore，禁止提交 Git
#
# 【配置优先级】
#   ENV > 本文件 > collectors.yml
#
# 【使用方式】
#   复制本文件为 collectors.local.yml，修改需要覆盖的配置
# ==============================================================================

# 覆盖全局调度配置
# scheduler:
#   parallel: true
#   timeout: 600

# 覆盖采集器配置
collectors:
  # 开发时只启用部分采集器
  alerion:
    enabled: true
    cron: "*/10 * * * *"       # 开发时每 10 分钟

  asl:
    enabled: false             # 开发时禁用

  noble:
    enabled: false

  example:
    enabled: true
    cron: "*/5 * * * *"        # 开发时每 5 分钟
